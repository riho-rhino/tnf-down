<div class="mv-wrap">
    <div class="mv-inner">
        <div class="mv-head">
            <h1 class="main-ttl en-bold">Stay Warm <span>with</span><br>Down Jacket</h1>
            <p class="main-subttl">ダウンジャケットで<br>暖かく過ごそう</p>
            <p class="main-season mv-season">2026 秋 / 冬</p>
        </div>
        <div class="mv-photo">
            <div class="mv-photo-main js-parallax">
                <img src="<%= rootURL %>/assets/img/mv_1.jpg" alt="">
            </div>
            <div class="mv-photo-sub">
                <div class="mv-photo-item mv-photo-item1 js-parallax">
                    <img src="<%= rootURL %>/assets/img/mv_2.jpg" alt="">
                </div>
                <div class="mv-photo-item mv-photo-item2 js-parallax">
                    <img src="<%= rootURL %>/assets/img/mv_3.jpg" alt="">
                </div>
                <div class="mv-photo-item mv-photo-item3 js-parallax">
                    <img src="<%= rootURL %>/assets/img/mv_4.jpg" alt="">
                </div>
            </div>
        </div>
        <div class="mv-logo">
            <img src="<%= rootURL %>/assets/img/logo.svg" alt="THE NORTH FACE">
        </div>
    </div>
</div>
