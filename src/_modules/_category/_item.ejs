<%#
  商品ブロック
  item.type
    'a' : 大2枚 + 小1枚（SP：縦並び / PC：大2枚横並び＋テキスト・小）
    'b' : 2枚（SP：スライダー / PC：2枚横並び）
    'c' : 大1枚 + 小1枚（SP：縦並び / PC：大1枚＋小・テキスト）
  画像は item{no}_{1〜3}.jpg
%>
<% const img = (n) => `${rootURL}/assets/img/item${item.no}_${n}.jpg` %>
<div class="item item-<%= item.type %>">

    <% if (item.type === 'a') { %>
    <figure class="item-img active item-img-l item-img-l-1"><div class="item-img-mask"><div class="item-img-inner"><img src="<%= img(1) %>" alt=""></div></div></figure>
    <figure class="item-img active item-img-l item-img-l-2"><div class="item-img-mask"><div class="item-img-inner"><img src="<%= img(2) %>" alt=""></div></div></figure>
    <figure class="item-img item-img-s js-float"><img src="<%= img(3) %>" alt=""></figure>
    <% } %>

    <% if (item.type === 'b') { %>
    <div class="item-slider">
        <div class="item-slider-track">
            <figure class="item-img active is-active"><div class="item-img-mask"><div class="item-img-inner"><img src="<%= img(1) %>" alt=""></div></div></figure>
            <figure class="item-img active"><div class="item-img-mask"><div class="item-img-inner"><img src="<%= img(2) %>" alt=""></div></div></figure>
        </div>
        <ul class="item-slider-dots">
            <li class="is-active" role="button" aria-label="1枚目を表示"></li>
            <li role="button" aria-label="2枚目を表示"></li>
        </ul>
    </div>
    <% } %>

    <% if (item.type === 'c') { %>
    <%# 画像は上に来る方が1枚目。SPは 小→大、PCは 大→小 の順に並ぶため、PC（920px以上）だけ画像を入れ替える %>
    <figure class="item-img item-img-s"><picture><source media="(min-width: 920px)" srcset="<%= img(2) %>"><img src="<%= img(1) %>" alt=""></picture></figure>
    <figure class="item-img item-img-xl js-scale-up"><picture><source media="(min-width: 920px)" srcset="<%= img(1) %>"><img src="<%= img(2) %>" alt=""></picture></figure>
    <% } %>

    <div class="item-detail js-clip-reveal">
        <p class="item-num">( <%= num %> )</p>
        <h3 class="item-name en"><a href="<%= item.url %>" target="_blank" rel="noopener"><%= item.name %></a></h3>
        <p class="item-kana"><%= item.kana %></p>
        <p class="item-price en"><%= item.price %></p>
        <p class="item-desc"><%= item.desc %></p>
        <%# STYLING ITEMS は商品がない場合は見出しごと出さない %>
        <% if (item.styling && item.styling.length) { %>
        <div class="item-styling en">
            <p class="item-styling-ttl">STYLING ITEMS</p>
            <ul class="item-styling-list">
                <% item.styling.forEach((s) => { %>
                <li><a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.name %></a>　<%= s.price %></li>
                <% }) %>
            </ul>
        </div>
        <% } %>
    </div>
</div>
