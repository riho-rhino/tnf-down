<div class="ending-wrap">
    <%# 背景の写真をフェードで切り替えてループ（_fade-loop.js）。表示中の方に is-active %>
    <%# 画像はPC（920px以上）：ending_{番号}.jpg ／ SP：ending_sp-{番号}.jpg（picture で画面幅に合う方だけ読み込む） %>
    <div class="ending-bg js-fade-loop">
        <div class="ending-bg-item ending-bg-item1 js-parallax is-active" data-parallax-scale="1.3">
            <picture>
                <source media="(min-width: 920px)" srcset="<%= rootURL %>/assets/img/ending_1.jpg">
                <img src="<%= rootURL %>/assets/img/ending_sp-1.jpg" alt="">
            </picture>
        </div>
        <div class="ending-bg-item ending-bg-item2 js-parallax" data-parallax-scale="1.1">
            <picture>
                <source media="(min-width: 920px)" srcset="<%= rootURL %>/assets/img/ending_2.jpg">
                <img src="<%= rootURL %>/assets/img/ending_sp-2.jpg" alt="">
            </picture>
        </div>
    </div>
    <div class="ending-inner">
        <div class="ending-head">
            <h1 class="main-ttl en-bold">
                <p><span>Stay Warm </span><span class="with">with</span></p>
                <p><span class="second">Down Jacket</span></p>
            </h1>
            <p class="main-subttl">ダウンジャケットで<br>暖かく過ごそう</p>
        </div>
        <p class="main-season ending-season">2026 秋 / 冬</p>
        <ul class="ending-credit en">
            <li>Photo：Masumi Ishida</li>
            <li>Styling：So Matsukawa</li>
            <li>Hair &amp; Make-up：Kentaro Katsu (SIGNO Inc.)</li>
            <li>Model：Mikiya Nakano (TOMORROW TOKYO Inc.),</li>
            <li>Aoi Watanabe(STARDUST PROMOTION Inc.)</li>
            <li>Design： Rikako Urayama(Rhino Inc.)</li>
            <li>Web Development：Hayato Miura</li>
            <li>Edit：Minami Miyakawa(Rhino Inc.)</li>
        </ul>
    </div>
</div>
